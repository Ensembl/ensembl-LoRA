/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    LoRA Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

includeConfig "$projectDir/params.config"
includeConfig "$projectDir/conf/base.config"
includeConfig "$projectDir/conf/modules.config"

params.input = params.input ?: params.sample_sheet
params.sample_sheet = params.sample_sheet ?: params.input
params.publish_dir_mode = params.publish_dir_mode ?: 'copy'
params.trace_report_suffix = params.trace_report_suffix ?: new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

profiles {
    slurm {
        includeConfig './conf/ebi_slurm.config'
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.pullTimeout = "3 hours"
        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = false
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
    }
    test {
        includeConfig './conf/test.config'
    }
}

env {
    PYTHONNOUSERSITE = 1
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name = 'LoRA'
    description = 'Long-read RNA-seq Analysis pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version = '0.1.0'
}

plugins {
    id 'nf-schema@2.5.1'
}
