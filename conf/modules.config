/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module publishing configuration for LoRA
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: 'PROCESS_SAMPLE_SHEETS' {
        publishDir = [
            [
                path: { "${params.outdir}/summary/" },
                mode: params.publish_dir_mode,
                pattern: "sample_metadata.csv"
            ]
        ]
    }

    withName: 'EDIT_FASTA_IDS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/read_id_maps/" },
                mode: params.publish_dir_mode,
                pattern: "*.read_id_map.tsv.gz"
            ],
            [
                path: { "${params.outdir}/${genome_id}/reads/read_summaries/" },
                mode: params.publish_dir_mode,
                pattern: "*.read_summary.tsv"
            ]
        ]
    }

    withName: 'EDIT_FASTQ_IDS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/read_id_maps/" },
                mode: params.publish_dir_mode,
                pattern: "*.read_id_map.tsv.gz"
            ],
            [
                path: { "${params.outdir}/${genome_id}/reads/read_summaries/" },
                mode: params.publish_dir_mode,
                pattern: "*.read_summary.tsv"
            ]
        ]
    }

    withName: 'COMBINE_READ_ID_MAPS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/read_id_maps/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COMBINE_READ_SUMMARIES' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/read_summaries/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'NP_MINIMAP2' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/all_reads/split/" },
                mode: params.publish_dir_mode,
                pattern: "*.bam*"
            ]
        ]
    }

    withName: 'PB_MINIMAP2' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/all_reads/split/" },
                mode: params.publish_dir_mode,
                pattern: "*.bam*"
            ]
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/all_reads/split/" },
                mode: params.publish_dir_mode,
                pattern: "*.bam*"
            ]
        ]
    }

    withName: 'SAMTOOLS_MERGE' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/all_reads/merged/" },
                mode: params.publish_dir_mode,
                pattern: "*.bam*"
            ]
        ]
    }

    withName: 'CHROMOSOME_SPLIT' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/all_reads/chromosomes/" },
                mode: params.publish_dir_mode,
                pattern: "*.bam*"
            ]
        ]
    }

    withName: 'FILTER_BAM_FOR_CANONICAL' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/canonical/chromosomes/" },
                mode: params.publish_dir_mode,
                pattern: "*bam*"
            ]
        ]
    }

    withName: 'SAMTOOLS_MERGE_CANONICAL' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/reads/canonical/merged/" },
                mode: params.publish_dir_mode,
                pattern: "*.canonical.bam*"
            ]
        ]
    }

    withName: 'BED_STRAND_FIX' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/splice_log/" },
                mode: "move",
                pattern: "*.log"
            ]
        ]
    }

    withName: 'BUILD_CONTAINS_FILES' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/all_models/chromosomes/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COMBINE_TRANSCRIPT_MODELS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/all_models/merged/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COMBINE_UNFILTERED_FULL_LENGTH_CONTAINS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/full_length/all_full_length/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'FILTER_GTF_FOR_FULL_LENGTH' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/full_length/models/chromosomes/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COMBINE_FILTERED_MODELS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/full_length/models/merged/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'FILTER_BAM_FOR_FULL_LENGTH' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/full_length/reads/chromosomes/" },
                mode: params.publish_dir_mode,
                pattern: "*.full_length.bam*"
            ]
        ]
    }

    withName: 'COMBINE_FULL_LENGTH_READS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/full_length/reads/merged/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COMBINE_FULL_LENGTH_STATS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/full_length/stats/" },
                mode: params.publish_dir_mode,
                pattern: "*_stats.tsv"
            ]
        ]
    }

    withName: 'PREPARE_SQANTI3_REFERENCE' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/sqanti3/reference/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'MERGE_SQANTI3_OUTPUTS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/sqanti3/${stage}/" },
                mode: params.publish_dir_mode,
                pattern: "sqanti3_output/*",
                saveAs: { filename -> filename.replaceFirst(/^sqanti3_output\//, '') }
            ]
        ]
    }

    withName: 'COUNT_LORA_SAMPLES' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/summary/metrics/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COUNT_LORA_INPUT_READS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/summary/metrics/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COUNT_LORA_MODELS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/summary/metrics/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'COUNT_LORA_SQANTI3' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/summary/metrics/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'CHECK_LORA_BAM_STATS' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/summary/metrics/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'BUILD_LORA_DATA_CHECKS' {
        publishDir = [
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                pattern: "data_checks/*",
                saveAs: { filename ->
                    def base = filename.tokenize('/').last()
                    def prefix = "${params.runID}_"
                    def suffix = "_data_checks.tsv"
                    if (base.startsWith(prefix) && base.endsWith(suffix)) {
                        def genome = base.substring(prefix.length(), base.length() - suffix.length())
                        return "${genome}/summary/checks/${base}"
                    }
                    return "summary/checks/${base}"
                }
            ]
        ]
    }

    withName: 'SUMMARISE_LORA_DASHBOARD' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/summary/" },
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: 'BUILD_LORA_DASHBOARD' {
        publishDir = [
            [
                path: { "${params.outdir}/${genome_id}/dashboard/" },
                mode: params.publish_dir_mode,
                pattern: "index.html"
            ],
            [
                path: { "${params.outdir}/${genome_id}/dashboard/" },
                mode: params.publish_dir_mode,
                pattern: "dashboard_data.json"
            ],
            [
                path: { "${params.outdir}/dashboard/${genome_id}/" },
                mode: params.publish_dir_mode,
                pattern: "index.html"
            ],
            [
                path: { "${params.outdir}/dashboard/${genome_id}/" },
                mode: params.publish_dir_mode,
                pattern: "dashboard_data.json"
            ]
        ]
    }

    withName: 'BUILD_LORA_DASHBOARD_INDEX' {
        publishDir = [
            [
                path: { "${params.outdir}/dashboard/" },
                mode: params.publish_dir_mode,
                pattern: "index.html"
            ]
        ]
    }
}
